diff --color -ruN -x target -x .git -x '*.mp4' -x node_modules -x out -x .ffmpeg -x fixtures a/crates/engine/src/web.rs b/crates/engine/src/web.rs
--- a/crates/engine/src/web.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/engine/src/web.rs	2026-10-17 20:25:06.740475403 +0000
@@ -0,0 +1,87 @@
+use std::num::NonZeroU32;
+
+use media::frame::{ColorRange, YuvFrame};
+use types::detection::FrameDetections;
+use types::rate::FrameRate;
+use types::size::SourceSize;
+
+use crate::background::BackgroundFrames;
+use crate::blur::{self, Blur};
+use crate::closing::Disk;
+use crate::config::{self, DetectConfig};
+use crate::detector::{BATCH, Detector};
+use crate::geometry::{self, Geometry};
+use crate::mask::{self, Mask};
+
+#[derive(Debug, thiserror::Error)]
+pub enum Error {
+    #[error("geometry")]
+    Geometry(#[from] geometry::Error),
+    #[error("blur")]
+    Blur(#[from] blur::Error),
+    #[error("mask")]
+    Mask(#[from] mask::Error),
+    #[error("config")]
+    Config(#[from] config::Error),
+    #[error("frame")]
+    Frame(#[from] media::frame::Error),
+}
+
+#[derive(Debug)]
+pub struct Streamed {
+    detector: Detector,
+    background: BackgroundFrames,
+    width: u32,
+    height: u32,
+    pushed: usize,
+    half_window: usize,
+}
+
+impl Streamed {
+    pub fn new(size: SourceSize, rate: FrameRate, announced: usize, config: &DetectConfig) -> Result<Self, Error> {
+        let geometry = Geometry::new(size, config.work_width())?;
+        let blur = Blur::new(config.target_sigma() / geometry.scale().factor(), geometry)?;
+        let disk = Disk::new(config.merge_radius() / geometry.scale().factor(), geometry);
+        let mask = Mask::new(config.osd_regions(), geometry.width(), geometry.height(), blur.reach())?;
+        let half_window = config.half_window(rate, geometry.pixels())?;
+        let detector = Detector::new(geometry, &blur, &disk, mask, half_window, config, BATCH);
+        let announced = std::num::NonZeroUsize::new(announced).unwrap_or(std::num::NonZeroUsize::MIN);
+        Ok(Self {
+            detector,
+            background: BackgroundFrames::new(announced),
+            width: size.width().get(),
+            height: size.height().get(),
+            pushed: 0,
+            half_window: half_window.get(),
+        })
+    }
+
+    pub fn workers(&self) -> usize {
+        self.detector.workers()
+    }
+
+    pub fn half_window(&self) -> usize {
+        self.half_window
+    }
+
+    pub fn push(&mut self, y: &[u8], u: &[u8], v: &[u8]) -> Result<(), Error> {
+        let mut frame = YuvFrame::new(self.width, self.height, ColorRange::Limited)?;
+        frame.y_mut().copy_from_slice(y);
+        frame.u_mut().copy_from_slice(u);
+        frame.v_mut().copy_from_slice(v);
+        let index = types::frame::FrameIndex::new(self.pushed);
+        self.background.offer(index, &frame);
+        self.detector.push(frame.y(), |_| {});
+        self.pushed += 1;
+        Ok(())
+    }
+
+    pub fn finish(self) -> (FrameDetections, Option<YuvFrame>) {
+        let detections = self.detector.finish();
+        (detections, self.background.into_background(&[]))
+    }
+}
+
+pub fn source_size(width: u32, height: u32) -> Option<SourceSize> {
+    Some(SourceSize::new(NonZeroU32::new(width)?, NonZeroU32::new(height)?))
+}
