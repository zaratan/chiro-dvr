@@ -0,0 +1,94 @@
+use std::fmt::Write;
+
+use engine::config::DetectConfig;
+use engine::damage::{Damage, Reports};
+use engine::web::Streamed;
+use tracking::exclusion::exclude;
+use tracking::stability::StabilityConfig;
+use tracking::track::{TrackConfig, track_detections};
+use types::detection::FrameDetections;
+use types::rate::FrameRate;
+use types::rational::Rational;
+
+#[cfg(all(target_arch = "wasm32", feature = "threads"))]
+pub use wasm_bindgen_rayon::init_thread_pool;
+
+pub struct Session {
+    streamed: Streamed,
+    rate: FrameRate,
+    size: types::size::SourceSize,
+    frames: usize,
+}
+
+impl Session {
+    pub fn new(width: u32, height: u32, num: i32, den: i32, announced: usize) -> Self {
+        let size = engine::web::source_size(width, height).unwrap();
+        let rate = FrameRate::new(Rational::new(num, den).unwrap()).unwrap();
+        let streamed = Streamed::new(size, rate, announced, &DetectConfig::default()).unwrap();
+        Self { streamed, rate, size, frames: 0 }
+    }
+
+    pub fn workers(&self) -> usize {
+        self.streamed.workers()
+    }
+
+    pub fn push(&mut self, y: &[u8], u: &[u8], v: &[u8]) {
+        self.streamed.push(y, u, v).unwrap();
+        self.frames += 1;
+    }
+
+    pub fn finish(self) -> String {
+        let half = self.streamed.half_window();
+        let (detections, background) = self.streamed.finish();
+        let damage = Damage::reported(Reports::default(), &[], self.frames, half);
+        let exclusion = exclude(&detections, damage.spans().to_vec(), damage.reported_frames(), self.rate, StabilityConfig::default());
+        let tracks = track_detections(&exclusion, self.size, TrackConfig::default()).unwrap();
+        let mut out = describe(&detections);
+        for (number, track) in tracks.iter().enumerate() {
+            writeln!(out, "track {} first {} last {} points {}", number + 1, track.first().frame.get(), track.last().frame.get(), track.points().len()).unwrap();
+        }
+        let checksum: u64 = background.map_or(0, |frame| frame.y().iter().map(|&b| u64::from(b)).sum());
+        writeln!(out, "background_y_sum {checksum}").unwrap();
+        out
+    }
+}
+
+fn describe(detections: &FrameDetections) -> String {
+    let mut out = String::new();
+    for (frame, found) in detections.iter() {
+        for d in found {
+            writeln!(out, "{} {} {} {} {} {} {} {} {}", frame.get(), d.x, d.y, d.left, d.top, d.width, d.height, d.area, d.amplitude).unwrap();
+        }
+    }
+    out
+}
+
+#[cfg(target_arch = "wasm32")]
+mod bindings {
+    use wasm_bindgen::prelude::*;
+
+    #[wasm_bindgen]
+    pub struct WebSession(Option<super::Session>);
+
+    #[wasm_bindgen]
+    impl WebSession {
+        #[wasm_bindgen(constructor)]
+        pub fn new(width: u32, height: u32, num: i32, den: i32, announced: usize) -> Self {
+            Self(Some(super::Session::new(width, height, num, den, announced)))
+        }
+
+        pub fn workers(&self) -> usize {
+            self.0.as_ref().map_or(0, super::Session::workers)
+        }
+
+        pub fn push(&mut self, y: &[u8], u: &[u8], v: &[u8]) {
+            if let Some(session) = self.0.as_mut() {
+                session.push(y, u, v);
+            }
+        }
+
+        pub fn finish(&mut self) -> String {
+            self.0.take().map(super::Session::finish).unwrap_or_default()
+        }
+    }
+}
