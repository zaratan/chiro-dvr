diff --color -ruN -x target -x .git -x '*.mp4' -x node_modules -x out -x .ffmpeg -x fixtures a/crates/media/src/region.rs b/crates/media/src/region.rs
--- a/crates/media/src/region.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/media/src/region.rs	2026-10-17 20:26:36.147070135 +0000
@@ -0,0 +1,23 @@
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Region {
+    pub left: u32,
+    pub top: u32,
+    pub width: u32,
+    pub height: u32,
+}
+
+impl Region {
+    pub fn fits(self, width: u32, height: u32) -> bool {
+        let even = [self.left, self.top, self.width, self.height]
+            .iter()
+            .all(|value| value % 2 == 0);
+        let inside = self.left.checked_add(self.width).is_some_and(|right| right <= width)
+            && self.top.checked_add(self.height).is_some_and(|bottom| bottom <= height);
+        even && self.width > 0 && self.height > 0 && inside
+    }
+
+    pub fn rows(self) -> usize {
+        self.height as usize
+    }
+}
+
