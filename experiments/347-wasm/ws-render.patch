@@ -0,0 +1,24 @@
+use std::io::Read;
+use std::time::Instant;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let (width, height): (usize, usize) = (args[2].parse().unwrap(), args[3].parse().unwrap());
+    let frames: usize = args[4].parse().unwrap();
+    let mut file = std::io::BufReader::with_capacity(1 << 24, std::fs::File::open(&args[1]).unwrap());
+    let (luma, chroma) = (width * height, width.div_ceil(2) * height.div_ceil(2));
+    let mut buffer = vec![0u8; luma + 2 * chroma];
+    let mut session = webproto::Session::new(width as u32, height as u32, 10000, 333, frames);
+    eprintln!("workers {}", session.workers());
+    let start = Instant::now();
+    let mut pushed = 0;
+    while pushed < frames && file.read_exact(&mut buffer).is_ok() {
+        let (y, rest) = buffer.split_at(luma);
+        let (u, v) = rest.split_at(chroma);
+        session.push(y, u, v);
+        pushed += 1;
+    }
+    let out = session.finish();
+    eprintln!("frames {pushed} seconds {:.3}", start.elapsed().as_secs_f64());
+    print!("{out}");
+}
